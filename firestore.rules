rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function protectedUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId
        && request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId
        && request.resource.data.roles == resource.data.roles;
    }
    match /users/{uid} {
      allow read: if owns(uid);
      // Profiler skrives kun via serveren, som håndhæver én konto pr. abonnent.
      allow create, update, delete: if false;
    }
    match /accountIdentityPhones/{fingerprint} {
      allow read, write: if false;
    }
    match /accountIdentityProfiles/{fingerprint} {
      allow read, write: if false;
    }
    // Atomic booking approvals use a server-only version lock per listing.
    match /pushDevices/{deviceId} {
      allow read, write: if false;
    }
    // Community data is exposed only through scoped, verified server endpoints.
    match /circlePreferences/{uid} { allow read, write: if false; }
    match /reviews/{id} { allow read, write: if false; }
    match /wanted/{id} { allow read, write: if false; }
    match /wantedLocks/{uid} { allow read, write: if false; }
    match /listingCalendars/{listingId} {
      allow read, write: if false;
    }
    match /bookingLocks/{listingId} {
      allow read, write: if false;
    }
    match /listings/{listingId} {
      allow read: if true;
      // Alle ændringer går gennem serveren, som håndhæver ejerskab og abonnementsgrænser.
      allow create, update, delete: if false;
    }
    match /agreements/{agreementId} {
      // Server API redacts contacts until owner approval, including legacy requests.
      allow read: if false;
      // Aftaler og alle fire underskrifter skrives kun via den verificerede server-API.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function participant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/agreements/$(agreementId)).data.participantUids;
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
