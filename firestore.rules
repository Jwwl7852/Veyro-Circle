rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function protectedUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.stripeCustomerId == resource.data.stripeCustomerId
        && request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId
        && request.resource.data.roles == resource.data.roles;
    }
    match /users/{uid} {
      allow read: if owns(uid);
      // Profiler skrives kun via serveren, som håndhæver én konto pr. abonnent.
      allow create, update, delete: if false;
    }
    match /accountIdentityPhones/{fingerprint} {
      allow read, write: if false;
    }
    match /accountIdentityProfiles/{fingerprint} {
      allow read, write: if false;
    }
    match /listings/{listingId} {
      allow read: if true;
      // Alle ændringer går gennem serveren, som håndhæver ejerskab og abonnementsgrænser.
      allow create, update, delete: if false;
    }
    match /agreements/{agreementId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.borrowerUid == request.auth.uid
        && request.resource.data.participantUids.size() >= 1
        && request.resource.data.participantUids.size() <= 2
        && request.resource.data.borrowerUid in request.resource.data.participantUids
        && (!request.resource.data.keys().hasAny(['lenderUid']) || (
          request.resource.data.lenderUid is string
          && request.resource.data.lenderUid != request.auth.uid
          && request.resource.data.lenderUid in request.resource.data.participantUids
        ))
        && request.resource.data.retentionUntil is timestamp
        && request.resource.data.retentionUntil > request.time
        && !request.resource.data.keys().hasAny(['borrowerSignature', 'lenderSignature']);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.borrowerUid == resource.data.borrowerUid
        && request.resource.data.lenderUid == resource.data.lenderUid
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          request.auth.uid == resource.data.borrowerUid ? 'borrowerSignature' : 'lenderSignature',
          'updatedAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function participant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/agreements/$(agreementId)).data.participantUids;
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }
  }
}
